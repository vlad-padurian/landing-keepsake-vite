footer.footer#contact
  .container
    .footer-top
      .newsletter-block
        h2.footer-heading Newsletter
        p.newsletter-desc Fresh case studies and design notes, once a month.

        form.newsletter-form(action="#newsletter-success", method="get")
          .field-row
            label.visually-hidden(for="newsletter-email") Email address
            input#newsletter-email.input-field(type="email", name="email", placeholder="Your email address", required, aria-describedby="email-error")
            button.btn.btn-primary.btn-subscribe(type="submit") Subscribe
          p#email-error.field-error Please enter a valid email address.
          .consent-row
            input#consent-check.consent-checkbox(type="checkbox", name="consent", required)
            label.consent-text(for="consent-check") I agree to the privacy policy

        p#newsletter-success.newsletter-success(role="status") Thank you! You are subscribed.

      .footer-links
        each column in footerColumns
          .footer-col
            h2.footer-heading= column.title
            ul.footer-list
              each link in column.links
                li
                  a(href=link.href)= link.text

    .footer-divider

    .footer-bottom
      p.copyright &copy; 2026 Keepsake. All rights reserved.
      +social-links(socials)

include to-top