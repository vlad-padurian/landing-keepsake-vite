section.clients.section
  .container
    h2.section-title Clients &amp; kind words
    p.section-desc Some of the teams that trusted us with their brands.

    ul.client-logos
      each client in clients
        li.client-logo(class=`logo-${client.id}`)= client.name

    blockquote.testimonial
      span.quote-mark(aria-hidden="true") &ldquo;
      p.testimonial-text= testimonial.text
      footer.testimonial-author
        .author-info
          .author-avatar(aria-hidden="true")= testimonial.initials
          .author-details
            p.author-name= testimonial.name
            p.author-role= testimonial.role
        .slider-dots(aria-hidden="true")
          each _, i in Array.from({ length: testimonial.slides })
            span.dot(class={ active: i === 0 })