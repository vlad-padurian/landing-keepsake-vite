section#about.services.section
  .container
    h2.section-title What do we do
    p.section-desc We are a small team of designers and makers who help brands look their best online and offline.

    .services__grid
      each service in services
        article.service-card
          .service-card__icon
            +icon(service.icon, 34, 30.6)
          h3.service-card__title= service.title
          p.service-card__text= service.text
