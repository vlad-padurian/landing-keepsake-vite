section.works.section#works
  .container
    each filter, i in filters
      input.filter-radio(class=`filter-radio--${filter.id}`, type="radio", name="portfolio-filter", id=`filter-${filter.id}`, checked=(i === 0))

    .works__head
      h2.section-title Our awesome works
      .works__chips
        each filter in filters
          label.chip(class=`chip--${filter.id}`, for=`filter-${filter.id}`)= filter.label

    .works__grid
      each work, i in works
        +work-card(work, i, filters)

    .works__more
      +btn('Load more works', null, 'secondary')(class="works__more-btn")