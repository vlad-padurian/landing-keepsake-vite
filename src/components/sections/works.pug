section.works.section#works
  .container
    each filter, i in filters
      input.filter-radio(type="radio", name="portfolio-filter", id=`filter-${filter.id}`, checked=(i === 0))

    .works-head
      h2.section-title Our awesome works
      .filter-chips
        each filter in filters
          label.chip(for=`filter-${filter.id}`)= filter.label

    .works-grid
      each work, i in works
        +work-card(work, i, filters)

    .load-more
      +btn('Load more works', null, 'secondary')(class="btn-load-more")