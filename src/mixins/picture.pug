mixin picture(name, alt, width, height, lazy = true, className, sizes = '100vw', widths = [width, width * 2])
  - const base = `/src/assets/images/${name}`;
  - const srcset = (ext) => widths.map((w) => `${base}-${w}.${ext} ${w}w`).join(', ');
  - const largest = widths[widths.length - 1];
  picture
    source(type='image/avif', srcset=srcset('avif'), sizes=sizes)
    source(type='image/webp', srcset=srcset('webp'), sizes=sizes)
    img(
      class=className,
      src=`${base}-${largest}.jpg`,
      srcset=srcset('jpg'),
      sizes=sizes,
      alt=alt,
      width=width,
      height=height,
      decoding='async',
      loading=lazy ? 'lazy' : false
    )
