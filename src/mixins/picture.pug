//- +picture(name, alt, width, height, lazy, className)
//- lazy = true: додає loading="lazy" (для всього, що поза першим екраном)
mixin picture(name, alt, width, height, lazy = true, className)
  if lazy
    img(class=className, src=`/src/assets/images/${name}.webp`, alt=alt, width=width, height=height, loading="lazy")
  else
    img(class=className, src=`/src/assets/images/${name}.webp`, alt=alt, width=width, height=height)