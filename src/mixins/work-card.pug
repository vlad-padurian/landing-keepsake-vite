mixin work-card(work, index, categories)
  - const category = categories.find((item) => item.id === work.category);
  article.work-card(data-category=work.category, tabindex='0')
    +picture(
      work.image,
      work.alt,
      358,
      282,
      true,
      'work-card__img',
      '(min-width: 1024px) 358px, (min-width: 768px) 50vw, 100vw',
    )
    .work-card__overlay
      span.work-card__icon(aria-hidden='true')
        +icon('plus')
      h3.work-card__title= work.title
      .work-card__divider
      span.work-card__cat= category.label
